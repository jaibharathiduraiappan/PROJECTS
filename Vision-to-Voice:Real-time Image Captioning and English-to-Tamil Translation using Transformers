Cell 4: Full pipeline function
from gtts import gTTS
def describe_image(path):
    image = PILImage.open(path).convert("RGB")
    display(image.resize((image.width // 2, image.height // 2)))

    # Step 1: English caption (BLIP)
    inputs = blip_processor(image, return_tensors="pt").to(device)
    with torch.no_grad():
        out = blip_model.generate(**inputs, max_new_tokens=30,
                                  num_beams=5, repetition_penalty=1.2)
    caption_en = blip_processor.decode(out[0], skip_special_tokens=True)
    print("English :", caption_en)
    # Step 2: Tamil translation (NLLB)
    tok_inputs = nllb_tok(caption_en, return_tensors="pt").to(device)
    with torch.no_grad():
        gen = nllb_model.generate(
            **tok_inputs,
            forced_bos_token_id=nllb_tok.convert_tokens_to_ids("tam_Taml"),
            max_new_tokens=60,
            num_beams=4,
        )
    caption_ta = nllb_tok.batch_decode(gen, skip_special_tokens=True)[0]
    print("Tamil   :", caption_ta)
    # Step 3: Tamil speech (gTTS)
    tts = gTTS(text=caption_ta, lang="ta")
    tts.save("caption_ta.mp3")
    display(Audio("caption_ta.mp3", autoplay=True))
    return caption_en, caption_ta
print("Pipeline ready")
